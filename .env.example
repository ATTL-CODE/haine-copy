# Copy to `.env` and fill in, or export these in your shell.
# HAINE reads these at runtime; nothing sensitive is hard-coded in the source.

# Google Earth Engine cloud project (Layer 2). Get one at https://code.earthengine.google.com
GEE_PROJECT=your-gee-project-id

# Where scripts save output figures (defaults to ~/Downloads if unset)
HAINE_DOWNLOAD_DIR=~/Downloads
